[Unit]
Description=Label-driven Docker host veth naming
Documentation=https://docs.docker.com/engine/network/drivers/bridge/
Wants=docker.service
After=docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
ExecStart=/usr/sbin/veth-renamer --mode=primary --mapping-file=/run/veth-renamer/mappings.json
Restart=on-failure
RestartSec=5
RuntimeDirectory=veth-renamer
RuntimeDirectoryMode=0755
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Do not enable PrivateNetwork or restrict namespace entry: nsenter needs host/netns access.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SYS_PTRACE
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
